@@ -489,6 +490,46 @@
 
   dt_exif_img_check_additional_tags(img, filename);
 
+  // A full-colour raw, such as a Nikon NEFX (pixel shift shots merged into
+  // one, with red, green and blue at every pixel): LibRaw keeps it as four
+  // channels a pixel. Loaded as an sRAW is: floats, no demosaic, but still
+  // camera RGB, so raw prepare, white balance and the camera matrix apply.
+  if(!raw->rawdata.raw_image && raw->rawdata.color4_image)
+  {
+    img->flags &= ~(DT_IMAGE_LDR | DT_IMAGE_RAW | DT_IMAGE_HDR | DT_IMAGE_4BAYER);
+    img->flags |= DT_IMAGE_S_RAW;
+    img->buf_dsc.filters = 0u;
+    img->buf_dsc.channels = 4;
+    img->buf_dsc.datatype = TYPE_FLOAT;
+    img->buf_dsc.cst = IOP_CS_RAW;
+    img->loader = LOADER_LIBRAW;
+    if(!mbuf)
+    {
+      err = DT_IMAGEIO_OK;
+      goto error;
+    }
+    float *out = dt_mipmap_cache_alloc(mbuf, img);
+    if(!out)
+    {
+      err = DT_IMAGEIO_CACHE_FULL;
+      goto error;
+    }
+    const ushort(*in)[4] = raw->rawdata.color4_image;
+    const int pitch = raw->rawdata.sizes.raw_pitch / 8;
+    const int w = img->width, h = img->height;
+    DT_OMP_FOR()
+    for(int j = 0; j < h; j++)
+      for(int i = 0; i < w; i++)
+      {
+        float *o = out + 4 * ((size_t)j * w + i);
+        const ushort *p = in[(size_t)j * pitch + i];
+        for(int k = 0; k < 3; k++) o[k] = p[k] / 65535.0f;
+        o[3] = 0.0f;
+      }
+    err = DT_IMAGEIO_OK;
+    goto error;
+  }
+
   // For CR3, we only have Bayer data and a single channel
   img->buf_dsc.channels = 1;
 
